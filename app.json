{
  "expo": {
    "name": "Auronix Seller",
    "slug": "auronix-seller",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "auronixseller",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/brand/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.auronixcommerce.seller",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.auronixcommerce.seller",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-foreground.png",
        "backgroundColor": "#07111F",
        "monochromeImage": "./assets/brand/adaptive-foreground.png"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-status-bar",
      "expo-notifications",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Auronix Seller to use Face ID to protect your seller workspace."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/splash-light.png",
          "backgroundColor": "#F5F8FC",
          "imageWidth": 178,
          "resizeMode": "contain",
          "dark": {
            "image": "./assets/brand/splash-dark.png",
            "backgroundColor": "#050A12"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
