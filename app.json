{
  "expo": {
    "name": "Auronix Seller",
    "slug": "auronix-seller",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "auronixseller",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.auronixcommerce.seller"
    },
    "android": {
      "package": "com.auronixcommerce.seller",
      "adaptiveIcon": {
        "backgroundColor": "#07111F"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
